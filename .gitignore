# ── Rust build output ────────────────────────────────────────────────────────
target/
**/target/
*.rs.bk

# ── Cross-compile artifacts ──────────────────────────────────────────────────
dist/
macos-dist/
*.tar.gz
*.zip
#   zune-gui/build-macos.sh writes to these (not the default `target/`)
target-*/

# ── The MTPZ key is the device's authentication secret. Never commit it. ─────
.mtpz-data
**/.mtpz-data
mtpz-data

# ── Machine-specific, rebuildable caches ─────────────────────────────────────
#   (the GUI keeps these under ~/Library/Application Support/zune-gui/, so this
#    only matters if a build ever writes into the tree)
covers/
library.json
*.miss

# ── Vendor / firmware binaries ───────────────────────────────────────────────
#   Fetched or extracted, tens-to-hundreds of MB each. GitHub rejects files over
#   100 MB outright, so these must never be `git add`ed as-is.
fw/
zfw/
KeelBaseline.Cab
winclient/bin/
winclient/msi/
winclient/x86/
winclient/*.exe
winclient/*.cab

# ── Editors / OS ─────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
.idea/
.vscode/
*.swp

# ── Scratch ──────────────────────────────────────────────────────────────────
*.log
/re-work/
/src-latest/
